@model List<CropAdvisory.Models.Crop>
@{
    ViewData["Title"] = "Manage Crops";
    Layout = "_AdminLayout";
}

<div class="pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0" style="color:var(--primary);">🌾 Manage Crops</h4>
        <a href="@Url.Action("CreateCrop", "Admin")" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Add New Crop
        </a>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Crop</th>
                        <th>Soil Type</th>
                        <th>pH Range</th>
                        <th>Season</th>
                        <th>Irrigation</th>
                        <th>Growing Period</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var crop in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@crop.CropName</div>
                                <div class="small text-muted text-truncate" style="max-width:250px;">@crop.Description</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@crop.SoilType</span></td>
                            <td>@crop.PHMin - @crop.PHMax</td>
                            <td><span class="badge bg-success-subtle text-success">@crop.Season</span></td>
                            <td>@(crop.NeedsIrrigation ? "Required" : "Rainfed")</td>
                            <td>@crop.GrowingPeriod</td>
                            <td class="text-end">
                                <a href="@Url.Action("EditCrop", "Admin", new { id = crop.CropId })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteCrop" asp-route-id="@crop.CropId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this crop?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
