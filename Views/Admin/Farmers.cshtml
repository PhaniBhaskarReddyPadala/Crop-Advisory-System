@model List<CropAdvisory.Models.Farmer>
@{
    ViewData["Title"] = "Registered Farmers";
    Layout = "_AdminLayout";
}

<div class="pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0" style="color:var(--primary);">👨‍🌾 Registered Farmers</h4>
        <span class="badge bg-success-subtle text-success fs-6">Total: @Model.Count</span>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Location</th>
                        <th>Language</th>
                        <th>Registered On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var farmer in Model)
                    {
                        <tr>
                            <td>#@farmer.FarmerId</td>
                            <td class="fw-semibold">@farmer.Name</td>
                            <td>@farmer.Email</td>
                            <td>@(string.IsNullOrEmpty(farmer.Location) ? "Not Specified" : farmer.Location)</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(farmer.PreferredLanguage == "te" ? "తెలుగు" : farmer.PreferredLanguage == "hi" ? "हिन्दी" : "English")
                                </span>
                            </td>
                            <td class="small text-muted">@farmer.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
