<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Farmer's Companion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Noto+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="farmer-layout">

    <!-- Desktop Sidebar -->
    <div class="sidebar d-none d-lg-flex flex-column">
        <div class="sidebar-brand">
            <i class="bi bi-flower1"></i>
            <span>Farmer's<br>Companion</span>
        </div>
        <nav class="sidebar-nav flex-grow-1">
            <a href="@Url.Action("Index","Dashboard")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-house-fill"></i><span>Home</span>
            </a>
            <a href="@Url.Action("SoilType","Crop")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Crop" ? "active" : "")">
                <i class="bi bi-flower2"></i><span>Crop Advice</span>
            </a>
            <a href="@Url.Action("Index","Weather")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Weather" ? "active" : "")">
                <i class="bi bi-cloud-sun-fill"></i><span>Weather</span>
            </a>
            <a href="@Url.Action("Index","Pest")" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pest" ? "active" : "")">
                <i class="bi bi-bug-fill"></i><span>Pest Guide</span>
            </a>
            <a href="@Url.Action("History","Crop")" class="sidebar-link">
                <i class="bi bi-clock-history"></i><span>My History</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-link w-100 text-start border-0 bg-transparent">
                    <i class="bi bi-box-arrow-left"></i><span>Logout</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="topbar d-flex align-items-center justify-content-between px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-flower1 text-success d-lg-none fs-4"></i>
                <span class="fw-bold text-success d-lg-none">Farmer's Companion</span>
                <h6 class="mb-0 d-none d-lg-block text-muted">@ViewData["Title"]</h6>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-md-inline text-muted small">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
                <!-- Language Switcher -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-translate"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <form asp-controller="Account" asp-action="SetLanguage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lang" value="en" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button class="dropdown-item" type="submit">🇬🇧 English</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="SetLanguage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lang" value="te" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button class="dropdown-item" type="submit">🇮🇳 తెలుగు</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="SetLanguage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="lang" value="hi" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button class="dropdown-item" type="submit">🇮🇳 हिन्दी</button>
                            </form>
                        </li>
                    </ul>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- Toast Notifications -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3 mt-2" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3 mt-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Page Body -->
        <div class="page-body px-3 pb-5 pb-lg-3">
            @RenderBody()
        </div>
    </div>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-nav d-flex d-lg-none">
        <a href="@Url.Action("Index","Dashboard")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-house-fill"></i><span>Home</span>
        </a>
        <a href="@Url.Action("SoilType","Crop")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Crop" ? "active" : "")">
            <i class="bi bi-flower2"></i><span>Crops</span>
        </a>
        <a href="@Url.Action("Index","Weather")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Weather" ? "active" : "")">
            <i class="bi bi-cloud-sun-fill"></i><span>Weather</span>
        </a>
        <a href="@Url.Action("Index","Pest")" class="mobile-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pest" ? "active" : "")">
            <i class="bi bi-bug-fill"></i><span>Pests</span>
        </a>
        <a href="@Url.Action("History","Crop")" class="mobile-nav-item">
            <i class="bi bi-clock-history"></i><span>History</span>
        </a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
