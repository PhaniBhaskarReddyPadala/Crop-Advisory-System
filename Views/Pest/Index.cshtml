@model CropAdvisory.ViewModels.PestListViewModel
@{
    ViewData["Title"] = "Pest Guide";
    Layout = "_FarmerLayout";
    var severityBadge = new Dictionary<string, string>
    {
        ["High"] = "danger", ["Medium"] = "warning", ["Low"] = "success"
    };
}

<div class="pt-3">
    <h4 class="fw-bold mb-1" style="color:var(--primary);">🐛 Pest Guide</h4>
    <p class="text-muted mb-4">Learn about common crop pests and how to protect your fields.</p>

    <!-- Filter by Crop -->
    <div class="mb-4">
        <label class="form-label fw-semibold small">Filter by Crop:</label>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index","Pest")" class="btn btn-sm @(!Model.SelectedCropId.HasValue ? "btn-success" : "btn-outline-success")">
                All Pests
            </a>
            @foreach (var crop in Model.Crops)
            {
                <a href="@Url.Action("Index","Pest",new{cropId=crop.CropId})"
                   class="btn btn-sm @(Model.SelectedCropId == crop.CropId ? "btn-success" : "btn-outline-success")">
                    @crop.CropName
                </a>
            }
        </div>
    </div>

    @if (!Model.Pests.Any())
    {
        <div class="card border-0 shadow-sm p-4 text-center" style="border-radius:16px;">
            <div class="fs-1 mb-3">✅</div>
            <h5 class="fw-bold">No pest advisories found</h5>
            <p class="text-muted">No pest information available for the selected crop.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var pest in Model.Pests)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100" style="border-radius:16px;overflow:hidden;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">🐛 @pest.PestName</h6>
                                <span class="badge bg-@(severityBadge.GetValueOrDefault(pest.Severity, "secondary"))">
                                    @pest.Severity Risk
                                </span>
                            </div>
                            @if (pest.Crop != null)
                            {
                                <div class="small text-muted mb-2"><i class="bi bi-flower2 me-1"></i>@pest.Crop.CropName</div>
                            }
                            <p class="text-muted small mb-3">@pest.Symptoms</p>
                            <a href="@Url.Action("Details","Pest",new{id=pest.PestId})" class="btn btn-outline-warning btn-sm w-100">
                                <i class="bi bi-info-circle me-1"></i>View Details & Treatment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
