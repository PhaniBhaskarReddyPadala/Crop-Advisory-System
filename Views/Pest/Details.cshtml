@model CropAdvisory.Models.PestAdvisory
@{
    ViewData["Title"] = Model.PestName;
    Layout = "_FarmerLayout";
    var severityClass = Model.Severity == "High" ? "danger" : Model.Severity == "Medium" ? "warning" : "success";
}

<div class="pt-3">
    <a href="@Url.Action("Index","Pest")" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Pest Guide
    </a>

    <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;overflow:hidden;">
        <div class="card-header py-3" style="background:var(--primary);">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-white mb-0">🐛 @Model.PestName</h5>
                <span class="badge bg-@severityClass border border-white">@Model.Severity Risk</span>
            </div>
            @if (Model.Crop != null)
            {
                <div class="small text-white opacity-75 mt-1"><i class="bi bi-flower2 me-1"></i>@Model.Crop.CropName</div>
            }
        </div>
        <div class="card-body p-4">
            <!-- Symptoms -->
            <div class="mb-4">
                <h6 class="fw-bold" style="color:var(--warning);">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Symptoms
                </h6>
                <p class="text-muted">@Model.Symptoms</p>
            </div>

            <!-- Prevention -->
            <div class="mb-4">
                <h6 class="fw-bold text-success">
                    <i class="bi bi-shield-check-fill me-2"></i>Preventive Measures
                </h6>
                <p class="text-muted">@Model.PreventiveMeasures</p>
            </div>

            <!-- Treatment -->
            <div class="mb-4">
                <h6 class="fw-bold text-danger">
                    <i class="bi bi-capsule me-2"></i>Treatment
                </h6>
                <p class="text-muted">@Model.Treatment</p>
            </div>

            <!-- Voice Button -->
            <button onclick="speakPest()" class="btn btn-outline-success w-100">
                <i class="bi bi-volume-up me-2"></i>Listen to Advisory
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
function speakPest() {
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        var text = '@Model.PestName. Symptoms: @Model.Symptoms. Prevention: @Model.PreventiveMeasures. Treatment: @Model.Treatment';
        var msg = new SpeechSynthesisUtterance(text);
        msg.lang = 'en-IN';
        msg.rate = 0.85;
        window.speechSynthesis.speak(msg);
    }
}
</script>
}
